<!--
  Cena: bancada de pericia forense.
  O UR10e (com caneta) fica no chao; a frente dele (+y) ha uma parede de gesso
  com marcas de projetil, e a esquerda (-x) uma mesa com uma placa onde ha
  fissuras de faca. O robo deve tracar circulos de raio R ao redor das marcas.

  Unidades: metros, radianos. Eixo z para cima.
-->
<mujoco model="cena_forense_ur10e">
  <include file="ur10e_caneta.xml"/>

  <statistic center="0 0.5 0.6" extent="1.6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.25 0.25 0.25" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="210" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="piso" builtin="checker" mark="edge" rgb1="0.35 0.35 0.38" rgb2="0.3 0.3 0.33"
      markrgb="0.6 0.6 0.6" width="300" height="300"/>
    <material name="piso" texture="piso" texuniform="true" texrepeat="4 4" reflectance="0.1"/>
    <material name="gesso" rgba="0.92 0.9 0.85 1"/>
    <material name="madeira" rgba="0.55 0.38 0.22 1"/>
    <material name="metal" rgba="0.45 0.47 0.5 1" specular="0.6"/>
    <material name="marca_tiro" rgba="0.08 0.06 0.05 1"/>
    <material name="caixa_evid" rgba="0.75 0.62 0.4 1"/>
    <material name="faixa" rgba="0.95 0.8 0.05 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true" diffuse="0.6 0.6 0.6"/>
    <light pos="0.8 -0.5 2" dir="-0.3 0.6 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="chao" size="0 0 0.05" type="plane" material="piso"/>

    <!-- Camera usada para gravar o video (no visualizador: Ctrl+]/[ ou painel Rendering) -->
    <body name="alvo_camera" pos="-0.25 0.45 0.6"/>
    <camera name="vista" pos="1.5 -1.3 1.6" mode="targetbody" target="alvo_camera" fovy="50"/>

    <!-- Base fixa do robo (apenas visual) -->
    <geom name="placa_base" type="cylinder" size="0.16 0.01" pos="0 0 0.01" material="metal"
      contype="0" conaffinity="0"/>

    <!-- PAREDE com marcas de projetil. Face frontal em y = 0.90 -->
    <body name="parede" pos="0 0.95 0.75">
      <geom name="parede" type="box" size="0.7 0.05 0.75" material="gesso"/>
      <!-- marcas: discos finos colados na face (y local = -0.05) -->
      <site name="tiro_1" pos="-0.25 -0.051 0.15"  size="0.008 0.001" type="cylinder" zaxis="0 1 0" material="marca_tiro"/>
      <site name="tiro_2" pos=" 0.05 -0.051 0.30"  size="0.006 0.001" type="cylinder" zaxis="0 1 0" material="marca_tiro"/>
      <site name="tiro_3" pos=" 0.30 -0.051 -0.05" size="0.007 0.001" type="cylinder" zaxis="0 1 0" material="marca_tiro"/>
    </body>

    <!-- MESA com placa de evidencia (fissuras de faca). Tampo em z = 0.45 -->
    <body name="mesa" pos="-0.85 0.25 0">
      <geom name="tampo" type="box" size="0.35 0.45 0.02" pos="0 0 0.43" material="madeira"/>
      <geom type="box" size="0.025 0.025 0.205" pos=" 0.3  0.4 0.205" material="metal"/>
      <geom type="box" size="0.025 0.025 0.205" pos="-0.3  0.4 0.205" material="metal"/>
      <geom type="box" size="0.025 0.025 0.205" pos=" 0.3 -0.4 0.205" material="metal"/>
      <geom type="box" size="0.025 0.025 0.205" pos="-0.3 -0.4 0.205" material="metal"/>
      <!-- placa de evidencia sobre o tampo (face superior em z = 0.46) -->
      <geom name="placa_evidencia" type="box" size="0.2 0.25 0.005" pos="0.1 0 0.455" material="gesso"/>
      <!-- fissuras de faca: caixas finas e alongadas -->
      <site name="faca_1" pos="0.15 0.10 0.4605" size="0.025 0.002 0.0005" type="box" euler="0 0 0.6" material="marca_tiro"/>
      <site name="faca_2" pos="0.05 -0.12 0.4605" size="0.02 0.002 0.0005" type="box" euler="0 0 -0.4" material="marca_tiro"/>
      <!-- caixas de evidencia -->
      <geom type="box" size="0.08 0.06 0.05" pos="-0.2 0.3 0.50" material="caixa_evid"/>
      <geom type="box" size="0.06 0.06 0.04" pos="-0.22 0.15 0.49" material="caixa_evid"/>
    </body>

    <!-- Cones / faixa de isolamento da area -->
    <geom type="cylinder" size="0.03 0.4" pos=" 0.9 -0.6 0.4" material="metal"/>
    <geom type="cylinder" size="0.03 0.4" pos="-0.9 -0.6 0.4" material="metal"/>
    <geom type="box" size="0.9 0.005 0.03" pos="0 -0.6 0.75" material="faixa" contype="0" conaffinity="0"/>

    <!-- Maleta de pericia no chao -->
    <geom type="box" size="0.2 0.14 0.08" pos="0.75 0.2 0.08" rgba="0.1 0.1 0.12 1"/>
  </worldbody>
</mujoco>
